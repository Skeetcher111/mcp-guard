# Пример окружения backend-сервиса MCP Guard.
# На VPS реальный файл лежит в /opt/mcp-guard-api/.env и в git не попадает.

# Своя база сервиса.
DATABASE_URL=sqlite:////opt/mcp-guard-api/mcpguard.db

# Единственный статический токен владельца.
# Задайте своё длинное случайное значение.
API_TOKEN=

# Фаза 16: ИИ-анализа нет, ключи ANTHROPIC_*/CLAUDE_* больше не читаются.

